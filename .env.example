# Client (frontend) API keys from https://geomi.dev
# Create a Client key on Testnet / Shelbynet. The same key can be used for both
# variables if Geomi issues a single client credential.
#
# Required at runtime for live Shelby RPC and Aptos API calls.
# Not required to run `npm install` or `npm run build`.
# Never commit a filled-in .env file.

VITE_SHELBY_API_KEY=
VITE_APTOS_API_KEY=
